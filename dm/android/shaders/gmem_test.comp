#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
// Raw global memory's self-test (gfx_vk_gmem.inc gm_selftest, DM_VK_RAW_GMEM_TEST=1): each lane reads 16 bytes as the translator's raw vector loads do, through a physical
// pointer aligned as a word, at a guest address plus the delta of the pool table entry the host names, and writes back what it read
layout(local_size_x = 64) in;
layout(buffer_reference, buffer_reference_align = 4) readonly buffer U4 { uvec4 v; };
layout(set = 0, binding = 0, std430) readonly buffer Tab { uint w[]; } tab;
layout(set = 0, binding = 1, std430) buffer Io { uvec4 req[64]; uvec4 got[64]; } io;   // req: the address's low and high words, the table entry
void main() {
    uint i = gl_LocalInvocationID.x; uvec4 r = io.req[i]; uint e = r.z * 8u;
    uint lo = r.x + tab.w[e + 4u], hi = r.y + tab.w[e + 5u] + (lo < r.x ? 1u : 0u);
    io.got[i] = U4(uvec2(lo, hi)).v;
}
